# NutriCare Agent Environment Variables Template
# Copy to .env and fill in your actual values
# NEVER commit .env with real secrets to git
#
# ⚠️ Tên biến dưới đây khớp CHÍNH XÁC với src/config.py (Settings) — pydantic-settings
# đọc theo tên field viết hoa (vd. gemini_api_key -> GEMINI_API_KEY). Đừng tự đặt tên
# khác (OPENAI_API_KEY chính, GOOGLE_API_KEY, ANTHROPIC_API_KEY…) rồi thắc mắc vì sao
# app không đọc được key — biến không khớp tên field sẽ bị bỏ qua âm thầm (extra="ignore").

# --- Application ---
APP_NAME=NutriCare Agent
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database ---
# Dev nhanh không cần Postgres: DATABASE_URL=sqlite:///./data/app.db
DATABASE_URL=postgresql://user:password@localhost:5432/nutricare
DB_CONNECT_TIMEOUT_SEC=10
DB_POOL_TIMEOUT_SEC=10
DB_POOL_RECYCLE_SEC=300
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- Vector Store ---
CHROMA_PERSIST_DIR=./data/chroma

# --- LLM — OpenAI (dự phòng, chưa dùng chính) ---
OPENAI_API_KEY=sk-...
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7

# --- LLM — Gemini (nguồn chính, nhiều key free để xoay vòng khi rate-limit) ---
GEMINI_API_KEY=AIza...
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-2.5-flash

# --- USDA FoodData Central (DAT-03) ---
USDA_API_KEY=

# --- Cách chọn món cho generate_menu (AGT-10) ---
# hybrid (mặc định) | cpsat (không cần key LLM) | gemini
MENU_GENERATOR=hybrid

# --- JWT Authentication ---
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# --- LangSmith Tracing (Optional, AGT-08) ---
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=nutricare-dev
LANGCHAIN_TRACING_V2=false

# --- AI Activity Logging (bắt buộc — SET-02, xem scripts/setup_hooks.sh) ---
AI_LOG_SERVER=https://ai-activity-log-server.fly.dev/logs
AI_LOG_API_KEY=your-ai-log-key
AI_LOG_DIR=.ai-log

# --- Render Deploy (Production) ---
# Set các biến trên trong Render dashboard, không commit vào .env
# DATABASE_URL (auto-provided by Render PostgreSQL)
# JWT_SECRET (generate: openssl rand -hex 32)
# GEMINI_API_KEY / OPENAI_API_KEY
# APP_ENV=production
