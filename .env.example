# NutriCare Agent Environment Variables Template
# Copy to .env and fill in your actual values
# NEVER commit .env with real secrets to git

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/nutricare

# --- JWT Authentication ---
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM API Keys ---
# Use one of: OpenAI, Anthropic, or Google Gemini
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Which model to use (openai, anthropic, or google)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- LangSmith Tracing (Optional) ---
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=nutricare-dev

# --- AI Activity Logging (VinUni) ---
AI_LOG_API_KEY=your-ai-log-key
AI_LOG_URL=https://ai-activity-log-server.fly.dev/logs
AI_LOG_MODEL=claude-sonnet-5

# --- Application ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Render Deploy (Production) ---
# Set these in Render dashboard, not in .env
# DATABASE_URL (auto-provided by Render PostgreSQL)
# JWT_SECRET (generate: openssl rand -hex 32)
# LLM API keys
# ENVIRONMENT=production
